# Shell scripts must keep LF endings; with CRLF, bash fails on every line.
*.sh text eol=lf

# `labnet driver build` writes LF and `--check` compares bytes, so a CRLF
# checkout (core.autocrlf=true on Windows) would always report stale files.
packages/labnet/src/labnet/grpc/generated/** text eol=lf

# Dockerfiles, compose.yaml and the egress allow-list are read inside Linux containers.
packages/labnet-automation/docker/** text eol=lf
