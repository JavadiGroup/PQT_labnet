.env
**/.env
lab_pc/tls/
*.key
*.p12
*.pfx

# Keep safe templates in version control
!.env.example
!**/.env.example

# Python-generated artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Local environments and build artifacts
.venv/
build/
dist/
*.egg-info/

# Runtime logs
*.log

# Central Server local database files
central_server/data/*.db
central_server/data/*.db-journal
central_server/data/*.db-shm
central_server/data/*.db-wal
