# Local credentials and environment overrides
# (*.env catches filled-in copies of templates such as sites/pqt/central.env.example)
.env
**/.env
*.env
*.key
*.pem
*.p12
*.pfx
logins.txt

# Keep safe templates in version control
!.env.example
!**/.env.example
!*.env.example

# Python-generated artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Local environments and build artifacts
.venv/
build/
dist/
*.egg-info/

# Runtime logs
*.log

# Local development network state (labnet dev): database, API keys, logs
.devnet/

# Output of examples/04_scan_two_devices.py
scan.csv

# Papers for Photo-Agent in development (LABNET_AGENT_LITERATURE_DIR)
literature/

# Experiments and Automation projects saved by the development Control Center
# (anchored: only the repository root's folders)
/experiments/
/automation/

# LabNet 2.x release builds (labnet bundle now writes to dist/)
/PQT_network_releases/
