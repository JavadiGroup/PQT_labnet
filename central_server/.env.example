# Environment-variable reference. Central does not auto-load this file; set
# these values in the process environment or deployment service configuration.
#
# SQLite is built into Python; no separate database service is required. If
# omitted, Central uses the current user's writable application-data directory.
# LABNET_DATABASE_URL=sqlite:///central_server/data/labnet.db
LABNET_CENTRAL_BIND_HOST=127.0.0.1
LABNET_CENTRAL_BIND_PORT=8008
LABNET_LEASE_MIN_SECONDS=5
LABNET_LEASE_MAX_SECONDS=86400
LABNET_HEARTBEAT_TIMEOUT_SECONDS=30
LABNET_MAINTENANCE_INTERVAL_SECONDS=5

# Development/test escape hatch only. Leave false in normal deployments and
# use the Alembic upgrade command documented below.
LABNET_CREATE_SCHEMA_ON_STARTUP=false
