<service>
  <id>LabNetUpdater</id>
  <name>LabNet Updater and Lab-PC Supervisor</name>
  <description>Stages, drains, switches, verifies, and rolls back LabNet runtimes.</description>
  <executable>C:\ProgramData\LabNet\updater-venv\Scripts\labupdater.exe</executable>
  <arguments>--config C:\ProgramData\LabNet\config\updater.toml run</arguments>
  <workingdirectory>C:\ProgramData\LabNet</workingdirectory>
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
</service>
