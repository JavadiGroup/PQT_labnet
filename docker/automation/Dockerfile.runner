# The runner image: the supervisor (`labnet-runner run`), and also the egress proxy
# (`python -m labnet.automation_runner.egress_proxy`, compose service "egress").
#
# The supervisor is trusted: it holds the runner token and talks to the Docker daemon through the
# mounted /var/run/docker.sock (root-equivalent on the runner host, which is why this host runs nothing
# else of value). Agents never get the socket. The egress service runs this image as nobody, read-only.
#
# Build context: the repository root (compose.yaml: context ../..).

# Base images are pinned by digest (the exact image tested); update the digest deliberately.
FROM python:3.11-slim-bookworm@sha256:0a310eeecf4e1f5a0743f9a6520c90c88d089c903ca5fd283f501e3a805f5f89

# Only the docker CLI (a static binary); the daemon is the host's.
COPY --from=docker:29-cli@sha256:35cfcf893c20f2931f4909151b5407aaaeab711277de7ce8b8f521f095d54c32 /usr/local/bin/docker /usr/local/bin/docker

# constraints.txt: the exact package versions tested.
COPY Labnet /src/Labnet
COPY docker/automation/constraints.txt /tmp/constraints.txt
RUN pip install --no-cache-dir --disable-pip-version-check -c /tmp/constraints.txt "/src/Labnet[runner]" \
 && rm -rf /src /tmp/constraints.txt

COPY docker/automation/egress-allow.txt /etc/labnet/egress-allow.txt

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

CMD ["labnet-runner", "run"]
