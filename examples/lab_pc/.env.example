# Safe local-development defaults. Copy this file to .env and edit locally.
LABNET_ENVIRONMENT=development
# Stable Central identity. Do not derive this from a hostname that may change.
LABNET_LAB_PC_ID=lab-pc-dev-01
# Human-readable/network host label reported separately to Central.
LABNET_LAB_PC_HOST=lab-pc-test

# A non-loopback Central Server URL must use HTTPS.
LABNET_CENTRAL_ENABLED=false
LABNET_SERVER_URL=http://127.0.0.1:8008
LABNET_DEVICE_MANAGER_API_KEY=
LABNET_HEARTBEAT_INTERVAL_SECONDS=5
LABNET_LEASE_VALIDATION_MODE=development

# Plaintext is allowed only on loopback. Use tls for a LAN bind.
LABNET_GRPC_BIND_HOST=127.0.0.1
LABNET_GRPC_PORT=50051
LABNET_GRPC_ADVERTISED_TARGET=127.0.0.1:50051
# Optional override when the certificate DNS name differs from the target host.
LABNET_GRPC_TLS_SERVER_NAME=
LABNET_GRPC_TLS_MODE=disabled
LABNET_GRPC_CERT_FILE=
LABNET_GRPC_KEY_FILE=
LABNET_GRPC_MAX_RECEIVE_BYTES=4194304
LABNET_GRPC_MAX_SEND_BYTES=4194304
LABNET_GRPC_SHUTDOWN_GRACE_SECONDS=5

# Wavemeter-style scalar streaming limits.
LABNET_STREAM_MAX_RATE_HZ=1000
LABNET_STREAM_MAX_SAMPLES=1000000
LABNET_STREAM_MAX_DURATION_SECONDS=3600
LABNET_STREAM_LEASE_REVALIDATION_SECONDS=5
LABNET_STREAM_SAMPLE_TIMEOUT_SECONDS=5
# The management plane remains loopback-only until HTTPS is configured.
LABNET_HTTP_BIND_HOST=127.0.0.1
LABNET_HTTP_PORT=9001

LABNET_DEVICE_QUEUE_CAPACITY=128
LABNET_DEVICE_START_TIMEOUT_SECONDS=10
LABNET_DEVICE_HEALTH_REFRESH_INTERVAL_SECONDS=5
LABNET_DEVICE_HEALTH_TIMEOUT_SECONDS=2
LABNET_DEFAULT_OPERATION_TIMEOUT_SECONDS=30
LABNET_HEALTH_SYNC_INTERVAL_SECONDS=1
