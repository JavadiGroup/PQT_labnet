# Central settings for the lab. Copy to C:\ProgramData\LabNet\central.env.
# Read by:  labnet-central --env-file C:\ProgramData\LabNet\central.env
#      and: labnet-central-admin --env-file C:\ProgramData\LabNet\central.env ...
# Values set in the process environment override this file.

LABNET_DATABASE_URL=sqlite:///C:/ProgramData/LabNet/Central/labnet.db

# The built-in server is plain HTTP and must stay on loopback. Caddy serves
# HTTPS on port 443 and forwards to this port.
LABNET_CENTRAL_BIND_HOST=127.0.0.1
LABNET_CENTRAL_BIND_PORT=8008

# Optional policy; these are the defaults.
# LABNET_LEASE_DEFAULT_IDLE_TIMEOUT_SECONDS=900
# LABNET_HEARTBEAT_TIMEOUT_SECONDS=30
