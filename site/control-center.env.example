# PQT Lab Control Center settings for the lab. It runs on central_server_pc,
# next to Central. Copy to C:\ProgramData\LabNet\control-center.env.
# Start by hand:  labnet-control-center --env-file C:\ProgramData\LabNet\control-center.env
#
# Start from the file `labnet-central-admin setup --user control-center
# --write-env ... --server-url http://127.0.0.1:8008` made: it already holds
# the two Central settings below. Development uses the same layout in
# .devnet/control-center.env (written by scripts/dev/seed.sh).

# Central on this same computer, over loopback: no CA file needed.
LABNET_SERVER_URL=http://127.0.0.1:8008
LABNET_API_KEY=<from setup --write-env>

# The built-in server is plain HTTP on loopback. Caddy serves it to the lab
# over HTTPS (see Labnet/README.md, "Control Center").
LABNET_CONTROL_CENTER_HOST=127.0.0.1
LABNET_CONTROL_CENTER_PORT=8080

# How often the network picture is refreshed from Central (seconds).
# LABNET_CONTROL_CENTER_REFRESH_SECONDS=3
