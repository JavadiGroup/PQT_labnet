# Lab PC settings for the lab. Copy to C:\ProgramData\LabNet\lab-pc.env.
# Read by:  labnet-lab-pc --env-file C:\ProgramData\LabNet\lab-pc.env
#
# Start from the file `labnet-central-admin setup --lab-pc atto-pc --write-env ...
# --server-url http://127.0.0.1:8008` made: it already holds the first three
# settings below. See DEPLOY.md.

LABNET_LAB_PC_ID=atto-pc
# Central runs on this same computer: over loopback, so the Lab PC doesn't
# depend on Caddy and needs no CA file. (A Lab PC on another computer uses
# https://192.168.1.149 and LABNET_CA_FILE.)
LABNET_SERVER_URL=http://127.0.0.1:8008
LABNET_DEVICE_MANAGER_API_KEY=<from setup --write-env>

LABNET_ENVIRONMENT=production

# The address clients dial. It must be in the certificate
# (labnet-certs issue atto-pc --ip 192.168.1.149 ...), which Caddy uses too.
LABNET_GRPC_ADVERTISED_TARGET=192.168.1.149:50051
LABNET_GRPC_CERT_FILE=C:/ProgramData/LabNet/certs/atto-pc.crt
LABNET_GRPC_KEY_FILE=C:/ProgramData/LabNet/certs/atto-pc.key

# This computer's instruments (labnet update --role lab-pc installs the site here).
LABNET_DEVICE_INVENTORY=C:/ProgramData/LabNet/site/inventories/atto_pc.py:create_devices
